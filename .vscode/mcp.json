{
	"servers": {
		"TestSprite": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@testsprite/testsprite-mcp@latest"
			],
			"env": {
				"API_KEY": "${input:testspriteApiKey}"
			}
		}
	},
	"inputs": [
		{
			"id": "testspriteApiKey",
			"type": "promptString",
			"description": "TestSprite API key",
			"password": true
		}
	]
}